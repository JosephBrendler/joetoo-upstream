# unicode_emojis.hdr - list of emoji unicode characters to include in registry, with substitute ascii text for logging

# associative array (-A) keyed on char name, global scope (-g)
declare -A -g unicode_emojis=()


# $ readarray -t lines < <(printf '%s\n' "$ACTIVE_EMOJI_REGISTRY")
# $ for line in "${lines[@]}"; do IFS="${US}" read -a parts <<< "$line"; echo "unicode_emojis[${parts[1]}]=\"${parts[3]}\""; done


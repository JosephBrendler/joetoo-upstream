_init_ascii_controls() # (POSIX) precook the set of emoji considered most "active" for optimizatoin
{ iac_ret=0; SED_LOG_FILTER=""
  # initialize global ASCII controls
  BEL=$(printf '\007')  # h:0x07, d:07;  only when you literally need bells and whistles
  BS=$(printf  '\010')  # h:0x08, d:08;  oves cursor one column left; does not erase
  HT=$(printf  '\011')  # h:0x09, d:09;  equiv \t (horizontal tab)
  LF=$(printf  '\012')  # h:0x0A, d:10;  (linefeed)
  VT=$(printf  '\013')  # h:0x0B, d:11   (vertical tab; rarely used)
  FF=$(printf  '\014')  # h:0x0C, d:12;  equiv \f (form feed; page break in printers)
  CR=$(printf  '\015')  # h:0x0D, d:13;  equiv \r (carriage return; moves cursor to column 0)
  ESC=$(printf '\033')  # h:01Bx, d:27;  see CSI, ESCon, ESG0 (introduces ANSI/VT control sequences)
  US=$(printf  '\037')  # h:0x1F, d:31;  Unit Separator (an ASCII "file separator"; ideal delimiter -never appears in normal text)
  DEL=$(printf '\177')  # h:0x7F, d:127; delete (destructive delete on paper tape; now a control character)
  EOF=$(printf '\032')  # h:0x1A, d:26;  End of File (aka SUB, CTRL-Z; but note: the byte itself is not an EOF character in Unix)
  SO=$(printf  '\016')  # h:0x0E, d:14;  Shift Out (switch to G1 character set (e.g., line-drawing)
  SI=$(printf  '\017')  # h:0x0F, d:15;  Shift In (switch back to G0 character set)

  # consolidate initial rules   ansi                 controls                           escapes
#  SED_LOG_FILTER="s/${ESC}\[[0-9;]*[mK]//g; s/[${SO}${SI}${BEL}${ESC}]//g; s/[${BS}${HT}${LF}${VT}${FF}${CR}${DEL}]/ /g; "
  # note : ${ESC}\[ is redundant - ESC followed by ESC (needs to be ${ESC}[ then the char class [...]
#  SED_LOG_FILTER="s/${ESC}[[0-9;]*[mK]//g; s/[${SO}${SI}${BEL}${ESC}]//g; s/[${BS}${HT}${LF}${VT}${FF}${CR}${DEL}]/ /g; "
  # 20260423 - add cursor-movement filters to ansi part
  SED_LOG_FILTER="s/${ESC}[[0-9;]*[mKABCDHfsulJ]//g;"
  SED_LOG_FILTER="${SED_LOG_FILTER} s/[${SO}${SI}${BEL}${ESC}]//g;"
  SED_LOG_FILTER="${SED_LOG_FILTER} s/[${BS}${HT}${LF}${VT}${FF}${CR}${DEL}]/ /g; "
  # note: _precook_ui_assets uses _precook_registry and _precook_unregistry to appends rules for each registry/unregistry
  return $iac_ret
}
_init_ascii_controls




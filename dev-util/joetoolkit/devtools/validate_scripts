# validate_scripts - check syntax or linting in all files found in specified directory tree

## shellcheck source=/usr/sbin/script_header_joetoo.shellcheck_var_stub
## shellcheck source=/usr/sbin/script_header_joetoo.shellcheck_func_stub
# shellcheck source=./script_header_joetoo.shellcheck_filtered_stub
source /usr/sbin/script_header_joetoo
source /usr/sbin/setTIMEFORMAT.hdr

#-----[ global variables ]-------------------------------------------------------------------

PN=${0##*/}   # basename

if [ -f /etc/joetoolkit/BUILD ]; then . /etc/joetoolkit/BUILD; else BUILD="0.0.1"; fi

# use "show-colors" to get a demonstrated list of colors in the joetoo pallet
title_clr="$Con"
line_clr="$BCon"

shebang='#!/'   #.........# #! followed by absolute path; ' to protect from bash thinking ! means history

# define embedded python command string to be used by python syntax checker below
cmd_str='
import ast   #.......................................# abstract syntax tree module for parsing
import sys   #.......................................# access argv and stderr
# catch syntax errors to control the output format
try:   #.............................................# attempt to parse the target
    with open(sys.argv[1], encoding="utf-8") as f:   # open target file as utf-8
        ast.parse(f.read(), filename=sys.argv[1])    # parse source without executing it
except SyntaxError as e:   #.........................# catch target syntax errors as exception e
    # report the error with specific fields in format (omit noisy Traceback block)
    print(f"{e.filename}:{e.lineno}:{e.offset}: SyntaxError: {e.msg}", file=sys.stderr)
    sys.exit(1)   #..................................# return failure to check_syntax
'   #................................................# end of cmd_str assignment

# set pseudo-boolean based on script_header_joetoo global TRUE=0; FALSE=""
j_msg "-${notice}" -p -n "looking for shellcheck ..."
if command -v shellcheck &>/dev/null; then result=0; SHELLCHECK=$TRUE; else result=1; SHELLCHECK=$FALSE; fi
handle_result "$result" "found" "not found" "$notice"

# initialize other pseudo-booleans to defaults
COMPACT=$FALSE   #.....# set if flags dictate, to display without per-file headings
FAILURES_ONLY=$FALSE   # set if flags dictate, to display output only from failed checks
LINT=$FALSE   #........# set if flags dictate, to run shellcheck instead of just language-native syngax check
#......................# Note: SHELLCHECK must be $TRUE (installed) to use LINT
TIMERS=$TRUE   #.......# set if flags dictate, to time overall and per-file execution

#-----[ ShellCheck context configuration ]-------------------------------------
# Enable optional lint-only context (-C); Bash never executes the context stub
CONTEXT_ENABLED=$FALSE  # optional ShellCheck-only lint context
# With -C=FILE, context_file is resolved from the specified context_explicit pathname for every applicable target.
# With -C alone, context_file is discovered independently for each target using nearest-ancestor lookup.
context_explicit=''
# Physical invocation directory; upper boundary for ancestor discovery.
CONTEXT_ROOT=$(pwd -P) || die 'cannot resolve invocation PWD'
# Accumulate context-check failures so later successful files cannot mask them.
context_exit_status=0
# Per-target context_file is resolved inside the checking loop:
#   -C=FILE : use the context_explicit pathname (no automatic discovery).
#   -C      : search from each target's directory upward through CONTEXT_ROOT.
# ShellCheck analyzes the resolved stub before the target, allowing it to
# recognize caller-provided globals/functions (including avoiding false SC2154
# warnings). Neither source file is executed during linting.

# initialize other variables expected in the joetoo ecosystem
logFile="/var/log/${PN}.log"

# set up varlist for show_config
varlist="PN BUILD verbosity loglevel bool.DEBUG bool.QUIET bool.LOGGING
    bool.UNICODE_CAPABLE bool.UNICODE_DISABLE bool.CONTEXT_ENABLED
    rlv.logFile rlv.target rlv.context_explicit
    bool.TIMERS bool.SHELLCHECK bool.COMPACT bool.FAILURES_ONLY bool.LINT
"

#-----[ functions ]-------------------------------------------------------------------

usage() {
    j_msg "-${debug}" -p "in ${FUNCNAME[0]}"
    local msg="${BRon}usage${BWon}: ${BGon}${PN}${Boff} ${Con}[/path/to/target] ${BMon}[options]${Boff}"
    j_msg "-${notice}" -p "$msg"
    j_msg "-${notice}" -m "${BYon}Options --${Boff}"
    msg="    ${BMon}-c|--compact${Boff} ${Con}...: ${BCon}compact (omit headings)${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="    ${BMon}-f|--failures${Boff} ${Con}..: ${BCon}show failures only${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="    ${BMon}-s|--syntax${Boff} ${Con}....: ${BCon}use language-native syntax checker w e.g. bash -n(default)${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="    ${BMon}-l|--lint${Boff} ${Con}......: ${BCon}(for shell) use shellcheck instead${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="    ${BMon}-t|--timers${Boff} ${Con}....: ${BCon}toggle overall & per-file timers (default: on)${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="    ${BMon}-C|--context${Boff} ${Con}...: ${BCon}auto-find nearest ShellCheck context stub${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="    ${BMon}-C=FILE${Boff} ${Con}........: ${BCon}use FILE as explicit ShellCheck lint context${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="    ${BMon}-h|--help${Boff} ${Con}......: ${BCon}Display this text${Boff}"
    j_msg "-${notice}" -mp "$msg"
    j_msg "-${notice}" -m "${BYon}Notes --${Boff}"
    msg="    ${Con}(1) Target may be either a regular file or a directory (default: \$PWD)${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="    ${Con}(2) For shell, recommend first check just syntax, then maybe run again with ${BMon}-l${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="    ${Con}(3) Recommend NOT using ${BMon}-l${Boff}${Con} on a directory with many files,${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="    ${Con}    maybe use a temp dir to check a small batch of just shell scripts${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="        ${Con}(to avoid really long jobs and mixing shellcode linting with${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="        ${Con} perl/python (currently) syntax-checking only)${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="    ${Con}(4) -C requires -l; without =FILE it searches from each target's directory${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="    ${Con}    upward to the invocation PWD (inclusive); nearest stub wins.${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="    ${Con}    Missing or unreadable context fails the check; no silent fallback.${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="    ${Con}(5) If TIMERS is not toggled off by ${BMon}-t${Boff} ${Con}millisecond resolution timing${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="        ${Con} is recorded both for each file processed and for the entire job.${Boff}"
    j_msg "-${notice}" -mp "$msg"
    msg="        ${Con} (final elapsed time is reported in the format DD:HH:MM:SS:mmm)${Boff}"
    j_msg "-${notice}" -mp "$msg"
}

# first get the command line house in order - derived from work I did on jping
normalize_cmdline() {
    j_msg "-${debug}" -p "in ${FUNCNAME[0]} with arg(s) [$*]"
    flags=()   #........# indexed array of normalized option flags (e.g. --lint -> l)
    remaining_args=()   # indexed array of parameters not consumed as/with options; handed off after parsing

    #...................# note: "$@" is the current set of positional parameters being parsed
    local arg   #.......# the parameter currently being parsed; see arg="$1" below - first positional parameter in "$@"
    #...................# (the semantic distinction is $1 is a "positional parameter",
    #...................#  whereas values handled by the program's command line interface (like $arg) are called "arguments")
    local chars   #.....# remaining characters in a the string of a compund arg (e.g. -cfl -> "cfl"
    local ch   #........# the leftmost char extracted from chars for examination

    # iterate throug positional parameters in $@
    while [ $# -gt 0 ]; do
        arg="$1"
        shift

        case "$arg" in
            --) # everything after -- is positional
                remaining_args+=("$@")
                break
                ;;
            # handle first all known -- prefixed flags
            --compact)   flags+=( c ) ;;
            --failures)  flags+=( f ) ;;
            --syntax)    flags+=( s ) ;;
            --lint)      flags+=( l ) ;;
            --timers)    flags+=( t ) ;;
            --context)   flags+=( C ) ;;
            --context=*)
                [[ ${arg#--context=} ]] || { j_msg "-${err}" -p '--context= requires a file'; exit 2; }
                flags+=( "C=${arg#--context=}" ) ;;
            --help)      flags+=( h ) ;;

            --*) # reject any other -- prefixed flag as invalid
                j_msg "-${err}" -p "invalid option [$arg]"
                usage
                exit 1
                ;;

            -C=*) # explicit context: separate syntax avoids consuming target pathname
                [[ ${arg#-C=} ]] || { j_msg "-${err}" -p '-C= requires a file'; exit 2; }
                flags+=( "C=${arg#-C=}" ) ;;

            -?*) # remove leading - and examine char-by-char (possible clustered short options)
                chars="${arg#-}"

                while [ -n "$chars" ]; do
                    ch="${chars:0:1}"   # assign first char as current character being parsed
                    chars="${chars:1}"  # strip first char and keep the remainder

                    # Keep capital C distinct from lowercase -c (compact).
                    # Other options preserve the existing case-insensitive policy.
                    [[ $ch == C ]] || ch="${ch,,}"

                    case "$ch" in
                        c|f|s|l|t|h|C)   # optional context accepts no separate operand
                            flags+=( "$ch" )
                            ;;
                        *)
                            j_msg "-${err}" -p "invalid option [-$ch] in [$arg]"
                            usage
                            exit 1
                            ;;
                    esac
                done
                ;;

            *) # didn't fit any pattern above - save for later; it is either target or an error
                remaining_args+=( "$arg" )
                ;;
        esac
    done
}

parse_cmdline() {
    j_msg "-${debug}" -p "in ${FUNCNAME[0]}"
    local arg="" result=0
    # examine each argument in the now-curated flags array and assign flags/values accordingly
    for arg in "${flags[@]}"; do
        case "$arg" in
            c) COMPACT=$TRUE ;;
            f) FAILURES_ONLY=$TRUE ;;
            s) LINT=$FALSE ;;
            l) LINT=$TRUE ;;
            t) if [ "$TIMERS" ] ; then TIMERS=$FALSE; else TIMERS=$TRUE; fi ;;
            C) CONTEXT_ENABLED=$TRUE; context_explicit='' ;;
            C=*) CONTEXT_ENABLED=$TRUE; context_explicit=${arg#C=} ;;
            h) usage; exit 0 ;;
        esac
    done

    if [ "${#remaining_args[@]}" -gt 1 ]; then
        j_msg "-${err}" -p "only one target may be specified"
        usage
        exit 1
    fi

    target="${remaining_args[0]:-$PWD}"

    # load target_array with 1 or more files depending on the nature of $target
    if [ -d "$target" ]; then
        # ingest filenames from a target directory (use -print0 for null-byte line termination
        j_msg "-${notice}" -p -n "ingesting filenames from target"
        mapfile -d '' target_array < <(find "$target" -type f -print0); result=$?
        [ ${#target_array[@]} -gt 0 ] || die "find/mapfile failed - target_array is empty"
        handle_result "$result" "ingested [${#target_array[@]}]" "" "$notice"
    elif [ -f "$target" ]; then
        #assign single filename to target_array
        j_msg "-${notice}" -p -n "ingesting filename from target"
        target_array=("$target"); result=$?
        handle_result "$result" "ingested [${#target_array[@]}]" "" "$notice" || \
            die "array assignment failed"

    else
        j_msg "-${err}" -p "target [$target] is not a regular file or directory"
        exit 1
    fi
}

choose_checker() {
    j_msg "-${debug}" -p "in ${FUNCNAME[0]} with arg(s) [$*]"
    local shebang_line="$1"
    # check basename of cleaned first word of shebang_line to choose the executable command for checking syntax
    local clean_first_word
    clean_first_word=$(echo "$shebang_line" | awk '{print $1}' | sed 's|^#!||')
    local base_executable="${clean_first_word##*/}"
    j_msg "-${debug}" -p "base_executable: $base_executable"
    # handle portable shebang wrappers (e.g. for python3 -> #!/usr/bin/env python3)
    if [ "$base_executable" = "env" ]; then
        # assign basename of second word of shebang_line
        local second_word
        second_word=$(echo "$shebang_line" | awk '{print $2}')
        base_executable="${second_word##*/}"
    fi
    j_msg "-${debug}" -p "base_executable: $base_executable"
    case "$base_executable" in
        # for valid shells, use the executable with its noexec flag (just parse to check syntax)
        # note: in openrc-run scripts, place # 'shellcheck shell=sh disable=SC1008'
        # below shebang to suppress 'unknown shebang' error
        openrc-run)
            if [ "$LINT" ]; then
                executable="$(command -v shellcheck)"
                arguments=( -x -s "sh" ) # -x = follow sources; -s names the shell (e.g. bash)
            else
                # fall back to e.g. bash -n
                executable=$(command -v "$(which sh)")
                arguments=( -n )
            fi
            ;;
        sh|ash|bash|dash)
            if [ "$LINT" ]; then
                executable="$(command -v shellcheck)"
                arguments=( -x -s "$base_executable" ) # -x = follow sources; -s names the shell (e.g. bash)
            else
                # fall back to e.g. bash -n
                executable=$(command -v "$base_executable")
                arguments=( -n )
            fi
            ;;
        # for busybox, use ash
        busybox)
            if [ "$LINT" ]; then
                executable="$(command -v shellcheck)"
                arguments=( -x -s "$base_executable" ) # -x = follow sources; -s names the shell (e.g. bash)
            else
                # fall back to ash -n
                executable=$(command -v "ash")
                arguments=( -n )
            fi
            ;;
        # for python, use -c w cmd_str assembled above (top of script)
        python3)
            executable=$(command -v "$base_executable")
            arguments=( -c "$cmd_str" )
            ;;
        # for perl, ignore other args that may have been on the shebang_line, and use perl -c to check syntax
        perl)
            executable=$(command -v "$base_executable")
            arguments=( -c )
            ;;
        # return 1 for invalid
        *               ) return 1;;
    esac
    j_msg "-${debug}" -p "executable: $executable"
    # cause return to be non-zero if this failed to set (or system doesnt have) the executable
    [ -n "$executable" ] && [ -x "$executable" ]
}

# Walk from the checked file's physical parent toward the invocation PWD.
# An explicit context may lie elsewhere; only discovery is root-bounded.
find_shellcheck_context() # Print selected lint context, without executing it
{
    local checked_file=$1 context_dir candidate
    # standard stub file name created by joetoolkit's shellcheck_stub_filter tool
    local stub=script_header_joetoo.shellcheck_filtered_stub
    if [[ $context_explicit ]]; then
        candidate=$context_explicit
        [[ -f $candidate && -r $candidate ]] || return 1
        printf '%s\n' "$candidate"
        return 0
    fi
    context_dir=$(cd -- "$(dirname -- "$checked_file")" && pwd -P) || return 2
    case $context_dir in
        "$CONTEXT_ROOT"|"$CONTEXT_ROOT"/*) ;;
        *) return 2 ;;
    esac
    while :; do
        candidate=$context_dir/$stub
        if [[ -f $candidate ]]; then
            [[ -r $candidate ]] || return 1
            printf '%s\n' "$candidate"
            return 0
        fi
        [[ $context_dir != "$CONTEXT_ROOT" ]] || break
        context_dir=${context_dir%/*}
        [[ $context_dir ]] || context_dir=/
    done
    return 1
}
# @usage find_shellcheck_context CHECKED_FILE
# @ret 0 with selected path on stdout; 1 if missing/unreadable; 2 if outside PWD.
# @rule Nearest parent wins; never search above the original physical PWD.

# ShellCheck reads the wrapper from stdin, follows two literal source paths,
# and reports issues at the original target filename/line number. Neither
# source file is run. Use Bash %q to preserve literal spaces/special characters.
# Do not pipe the wrapper through an intermediate command that changes status.
run_context_shellcheck() # Lint target with an additional static-only context
{
    local checked_file=$1 context_file=$2 dialect=$3
    local target_abs context_abs
    target_abs=$(cd -- "$(dirname -- "$checked_file")" && printf '%s/%s' "$(pwd -P)" "$(basename -- "$checked_file")") || return 2
    context_abs=$(cd -- "$(dirname -- "$context_file")" && printf '%s/%s' "$(pwd -P)" "$(basename -- "$context_file")") || return 2
    {
        printf '#!/bin/sh\n'
        printf '. %q\n' "$context_abs"
        printf '. %q\n' "$target_abs"
    } | shellcheck -x -s "$dialect" -P "$CONTEXT_ROOT" -
}
# @usage run_context_shellcheck TARGET CONTEXT SHELL_DIALECT
# @ret ShellCheck status; files are parsed but never sourced by a shell.
# @req Target and context are readable files; only compatible shell sources.

sanity_check() {
    j_msg "-${debug}" -p "in ${FUNCNAME[0]}"
    # generalize for more than one thing to check - return nonzero if any fail, and caller should then die
    local FLAGGED=$FALSE
    if [ "$LINT" ] && [ ! "$SHELLCHECK" ] ; then
        j_msg "-${err}" "lint requested but shellcheck is not available"
        FLAGGED=$TRUE
    fi
    # placeholder for other checks
    if [ "$CONTEXT_ENABLED" ] && [ ! "$LINT" ]; then
        j_msg "-${err}" -p '-C/--context requires -l/--lint (last -s/-l option wins)'
        FLAGGED=$TRUE
    fi
    [ "$FLAGGED" ] && return 1
    return 0
}

# to-do move this to script_header_joetoo
millis2time()   # (POSIX) convert integer ms to time format
{ mt_ret=0; _mt_ms=${1:-0}

  # use clock- (modulo- %) math to calculate the time-format fields that will be printed in a string with colon delimiter
  # math.division: dividend of x / divisor consists of quotient and remainder
  # quotient is the whole number of divisors in x
  # remainder is a number less than divisor that is left once the quotient is subtracted from x
  # in POSIX shell (( x / divisor )) produces the "quotient - whole part" of division
  # in POSIX shell (( x % divisor )) produces the "remainder - fractional part" of division
  _mt_mmm=$(( _mt_ms % 1000 )) || mt_ret=1  #..................# millisecond part = remainder when max whole # of seconds is removed

  _mt_sec=$(( _mt_ms / 1000 )) || mt_ret=$(( mt_ret | 2 ))     # integer number of seconds in elapsed time
  _mt_ss=$((  _mt_sec % 60  ))  || mt_ret=$(( mt_ret | 4 ))    # seconds part = remainder when max whole # of minutes is removed

  _mt_min=$(( _mt_sec / 60  ))  || mt_ret=$(( mt_ret | 8 ))    # integer number of minutes in elapsed time
  _mt_mm=$((  _mt_min % 60  ))  || mt_ret=$(( mt_ret | 16 ))   # minutes part = remainder when max whole # of hrs is removed

  _mt_hrs=$(( _mt_min / 60  ))  || mt_ret=$(( mt_ret | 32 ))   # integer number of hours in elapsed time
  _mt_hh=$((  _mt_hrs % 24  ))  || mt_ret=$(( mt_ret | 64 ))   # hours part = remainder when max whole number of days is removed

  _mt_dd=$((  _mt_hrs / 24  ))  || mt_ret=$(( mt_ret | 128 ))  # integer number of days in elapsed time

  # return (emit) time-formatted string on stdout
  printf "%02d:%02d:%02d:%02d:%03d\n" "$_mt_dd" "$_mt_hh" "$_mt_mm" "$_mt_ss" "$_mt_mmm"  || mt_ret=1

  unset -v _mt_ms _mt_mmm _mt_ss _mt_sec _mt_mm _mt_min _mt_hrs _mt_hh _mt_dd
  return "$mt_ret"
}
# @usage millis2time [MILLISECONDS]
# @args $1 non-negative integer milliseconds; defaults to 0
# @ret emits elapsed time as DD:HH:MM:SS:mmm; returns 0 on success
# @rule hours, minutes, seconds, and milliseconds are modulo clock fields
# @note days are unbounded; other fields are clock-modulo values;
# @append output represents elapsed duration, not wall time

# Invoke the usual checker, except when a shell target has an explicit lint
# context. This keeps the existing timing/reporting branches unchanged.
run_selected_check() # Run the file's checker, optionally with lint context
{
    if [[ $CONTEXT_ENABLED && $context_dialect ]]; then
        run_context_shellcheck "$x" "$context_file" "$context_dialect"
    else
        "$executable" "${arguments[@]}" "$x"
    fi
}
# @usage run_selected_check
# @ret Underlying checker result.


#-----[ main script ]-------------------------------------------------------------------

separator "$(hostname)" "${PN}-${BUILD}"

# to do: build a config file this can read
# read config file for user-modified default
config_file="/etc/${PN}/${PN}.conf"
if [ -f "$config_file" ] ; then
    j_msg "-${notice}" -p "sourcing config file [$config_file]"
    source "$config_file"
    handle_result $? "" "" "$notice" || die "tried and failed to source config file [$config_file]"
fi

# normalize the command line to facilitate parsing
# (e.g. translate --compact to ( c ) or -cfl to ( c f l )
normalize_cmdline "$@" || die "failed to normalize_cmdline"
# set actual logic flags and environment variables based on flags[]
parse_cmdline || die "failed to parse_cmdline"

d_do 'show_config || die "failed to show_config"' "$info"

sanity_check || die "failed to sanity_check"

d_do confirm_continue_or_exit "$info"

# record start time at millisecond resolution
# ( %s is seconds since epoch; %3N is first three digits of nanosecond field )
start_millis=$(date +%s%3N)

separator "${PN}-${BUILD}" "(target: $target)"

# interate through the one or more filenames in the target loaded by parse_cmdline
for x in "${target_array[@]}" ; do
    # ignore with warning if this file has no shell script shebang

    # read the first line of each file into shebang_line
    IFS= read -r shebang_line < "$x"
    candidate="${shebang_line:0:3}"

    # With explicit context mode, a shebang-less source is treated as Bash;
    # otherwise retain the original shebang-based checker selection.
    if [[ $candidate != "$shebang" ]]; then
        if [ "$CONTEXT_ENABLED" ] && [[ ! -d $target ]]; then
            shebang_line='#!/bin/bash'
        else
            j_msg "-${debug}" -p "no shebang [$shebang] in file [$x]; skipping"
            continue
        fi
    fi

    # call choose_checker;warn and skip if shebang is invalid
    if ! choose_checker "$shebang_line"; then
        j_msg "-${debug}" -p "Invalid shebang_line [$shebang_line]; skipping file [$x]"
        continue
    fi


    # A context affects ShellCheck shell targets only; Python/Perl retain their
    # native checkers. Determine the dialect from the already-selected -s flag.
    context_dialect=''; context_file=''
    if [ "$CONTEXT_ENABLED" ] && [[ $executable == "$(command -v shellcheck)" ]]; then
        for (( context_i=0; context_i<${#arguments[@]}; context_i++ )); do
            if [[ ${arguments[$context_i]} == -s ]]; then
                context_dialect=${arguments[$((context_i + 1))]}
                break
            fi
        done
        if ! context_file=$(find_shellcheck_context "$x"); then
            # it is not pseudo-boolean, but if context_explicit is populated then alert on fail to assign context_file
            if [ "$context_explicit" ]; then
                j_msg "-${err}" -p "ShellCheck context is missing or unreadable [$context_explicit]"
            else
                j_msg "-${err}" -p "No script_header_joetoo.shellcheck_filtered_stub found for [$x] within [$CONTEXT_ROOT]"
            fi
            context_exit_status=1
            continue
        fi
        j_msg "-${debug}" -p "ShellCheck context for [$x]: [$context_file]"
    fi
    # space with a blank line, and print file pathname, underlined
    [ ! "$COMPACT" ] && {
        echo; echo -e "${title_clr}${x}${Boff}";
        echo -e "${line_clr}$(repeat '-' ${#x})${Boff}" ; }


    # add optional debug info
    j_msg "-${debug}" -p "executable: $executable"
    j_msg "-${debug}" -p "arguments[*]: ${arguments[*]}"

    # build and use syntax checking command
    # note: shell and python checks put nothing on stdout (fd 1), errors to stderr (fd 2), but
    # perl puts errors on stderr and it also puts "syntax OK" on stderr on success
    # So - redirect stderr to stdout and filter the misplaced syntax OK with grep, and
    # use j_msg to communicate positive results as appropriate
    if [ "$FAILURES_ONLY" ]; then
        if [ "$TIMERS" ] ; then
            j_msg "-${debug}" -p "full command: [time $executable ${arguments[*]} $x]"
            # Note: use bash PIPESTATUS array to get exit status of the command, not the grep
            #   use setTIMEFORMAT.hdr (sourced above) function to customize time output (-l = long format)
            setTIMEFORMAT -l
            time run_selected_check 2>&1 | grep -v 'syntax OK'
            if [ "${PIPESTATUS[0]}" -ne 0 ] ; then
                j_msg "-${err}" -m "$x failed syntax check"
                [ "$CONTEXT_ENABLED" ] && context_exit_status=1
            fi
            unset TIMEFORMAT
        else
            j_msg "-${debug}" -p "full command: [$executable ${arguments[*]} $x]"
            # Note: use bash PIPESTATUS array to get exit status of the command, not the grep
            run_selected_check 2>&1 | grep -v 'syntax OK'
            if [ "${PIPESTATUS[0]}" -ne 0 ] ; then
                 j_msg "-${err}" -m "$x failed syntax check"
            fi
                 [ "$CONTEXT_ENABLED" ] && context_exit_status=1
        fi
    else
        # idx_* globals are generated by script_header_joetoo from the emoji registry
        # shellcheck disable=SC2154
        # set timer according to user specification tracked in "$TIMERS"
        if [ "$TIMERS" ] ; then
            j_msg "-${debug}" -p "full command: [time $executable ${arguments[*]} $x]"
            j_msg "-${notice}" -mp -M "$idx_magnifying_glass_right" "checking $x ..."
            #   use setTIMEFORMAT.hdr (sourced above) function to customize time output (-l = long format)
            setTIMEFORMAT -l
            time run_selected_check 2>&1 | grep -v 'syntax OK'
            result="${PIPESTATUS[0]}"
            unset TIMEFORMAT
            if [ "$CONTEXT_ENABLED" ] && (( result != 0 )); then context_exit_status=1; fi
        else
            j_msg "-${debug}" -p "full command: [time $executable ${arguments[*]} $x]"
            j_msg "-${notice}" -mp -M "$idx_magnifying_glass_right" "checking $x ..."
            run_selected_check 2>&1 | grep -v 'syntax OK'
            result="${PIPESTATUS[0]}"
        fi
            if [ "$CONTEXT_ENABLED" ] && (( result != 0 )); then context_exit_status=1; fi
        j_msg "-${notice}" -p -n "done; result:"
        handle_result "$result" "Ok $bin_check_mark_button" "errors $bin_cross_mark" "$notice"
    fi
done   # for each file

# record finish time at millisecond resolution
# ( %s is seconds since epoch; %3N is first three digits of nanosecond field )
finish_millis=$(date +%s%3N)
# calculate elapsed time
elapsed_millis=$(( finish_millis - start_millis ))
# call millis2time to calculate elapsed_time
elapsed_time=$(millis2time "$elapsed_millis")
if [ "$TIMERS" ] ; then
    msg="${BYon}$PN complete. ${BCon}Total elapsed time (DD:HH:MM:SS:mmm): ${BBon}[${BMon}$elapsed_time${BBon}]${Boff}"
    j_msg "-${notice}" -p "$msg"
fi
# In contextual lint mode missing context and ShellCheck errors must make the
# overall command fail, rather than only printing an error line.
if [ "$CONTEXT_ENABLED" ]; then exit "$context_exit_status"; fi

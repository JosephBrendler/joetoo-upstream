# remove pre-existing alias (which gcsm used to be) so we can use this function
unalias gcsm 2>/dev/null
gcsm() # (BASH) submit signed commit (follow with gpom to push)
{   local _gcsm_msg="${1:-}"
    echo 'test' > ~/cachetest  #.............................# create a dummy file to sign
    gpg --clearsign ~/cachetest > /dev/null 2>&1 || true  #..# sign file w pinentry, cache the key, ignore pcscd error msg
    [ -f ~/cachetest.asc ] || return 1   #...................# verify the file signature (.asc) was created
    rm ~/cachetest.asc  #....................................# remove the signature to reset
    git commit -s -S -m "${_gcsm_msg}"  #....................# signoff and sign the commit
}
# @usage gcsm <message>
# @note author converted alias gcsm to a function for clarity, but this is still built
# @append to treat gpg failure as a warning rather than a blocker
# @note for git commit options --
# @cont  -s | --signoff = add Signed-off-by line IAW GLEP-76 (DCO)
# @cont  -S | --gpg-sign [<key-id>] = sign w gnupg signing key (or --no-gpg-sign; overrides default)
# @note reference: https://www.kernel.org/pub/software/scm/git/docs/git-commit.html
# @note if a repo's ./.git/config or the users /home/<user>/.gitconfig contains "gpgsign = true" in a [commit]
# @cont block, and "signingkey = <gpg-key-id>" in a [user] block, then --gpg-sign will default
# @cont to that and --no-gpg-sign will turn it off

pcsm() # (BASH) submit signed commit (follow with gpom to push)
{   local _gcsm_msg="${1:-}"
    echo 'test' > ~/cachetest  #.............................# create a dummy file to sign
    gpg --clearsign ~/cachetest > /dev/null 2>&1 || true  #..# sign file w pinentry, cache the key, ignore pcscd error msg
    [ -f ~/cachetest.asc ] || return 1   #...................# verify the file signature (.asc) was created
    rm ~/cachetest.asc  #....................................# remove the signature to reset
    pkgdev commit --scan --signoff --gpg-sign -m "${_gcsm_msg}"  # signoff and sign the commit
}
# @usage pcsm <message>
# @note note for pkgdev commit options --
# @rule pcsm is prefered for eclass maintenance due tobetter metadata manifest mgmt via pkgdev commit
# @cont  -s | --scan for QA
# @warn  (*** caveat: for pkgdev commit, -s is NOT --signoff ***)
# @cont  --signoff = add Signed-off-by line IAW GLEP-76 (DCO)
# @cont  --gpg-sign (or --no-gpg-sign) passes --gpg-sign to git --commit
# @cont  (there is no capital -S for pkgdev)
# @note reference: https://pkgcore.github.io/pkgdev/man/pkgdev.html#id4
# @note if a repo's ./.git/config or the users /home/<user>/.gitconfig contains "gpgsign = true" in a [commit]
# @cont block, and "signingkey = <gpg-key-id>" in a [user] block, then --gpg-sign will default
# @cont to that and --no-gpg-sign will turn it off


# use this to count the number of uses of policy $1 on each line in file $2
# (in awk sub/gsub replacement, "&"  means "the exact text that was matched"
#  so gsub(p, "&") replaces the pattern with itself, leaving the line unmodified
#  c = gsub() assigns the number of successful substitutions made)
# count_policy() { p="$1"; f="$2"; awk -v p="$p" '{ c = gsub(p, "&"); print c ": " $0 }' "$f"; }
# example: count_policy nodist package.env  | grep '^2' | grep -v "^${W0}0" 

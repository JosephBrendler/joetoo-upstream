cleanup_archive_temp() {
    # clean up temp archive - safe to call repeatedly, including from die(), leave(), and EXIT trap

    # return with no action if global temp_path is unset or empty
    [ -n "${temp_path:-}" ] || return 0

    # if the temporary archive exists, delete it
    if [ -e "$temp_path" ] || [ -L "$temp_path" ]; then
        rm -f -- "$temp_path" || return 1
    fi

    # since the file no longer exists, reset the temp_path variable
    temp_path=""
    return 0
}


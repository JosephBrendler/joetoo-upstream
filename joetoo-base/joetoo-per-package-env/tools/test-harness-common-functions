discover_and_validate_ts() {
    # shell check cant find assignment of $debug (script_header_joetoo sourced separately)
    # shellcheck disable=SC2154
    j_msg "-${debug}" -p "in ${FUNCNAME[0]}"
    local -a find_args=()
    local candidate_ts=""
    local result=0
    status_file=""   # initialize (and assign, below) global status_file variable
    # identify the most recent status file
    # find files matching template; print path (%p)
    # build find_args in an array in order to comment/explain each
    find_args=( /tmp/ -mindepth 1 -maxdepth 1 )   #........# look inside the /tmp/ dir only, not at it or subdirs
    find_args+=( -type f -name 'test-harness-status-*' )   # filter for files with name matching template
    find_args+=( ! -name '*.tmp' )   #.....................# exclude .tmp files to avoid accicental selection
    find_args+=( -printf '%p\n' )   #......................# print path (date-sortable b/c ts in in filename)
    # pipe find output through filters - sort reverse and keep first only
    # guard against file not found or found but testing hasnt put anything in it yet
    # ( -s tests size > 0; if file not found, then "$status_file"  = "" and -s fails
    status_file=$( find "${find_args[@]}" | sort -r | head -n 1 );
    if [ -n "$status_file" ] ; then
        candidate_ts="${status_file##*test-harness-status-}"
        if is_valid_timestamp "$candidate_ts"; then
            result=0
            ts="$candidate_ts"
        else
            result=$?
            die "invalid timestamp [$candidate_ts] in discover_and_validate_ts" "$result"
        fi
    else
        # use 1 for die's $2 b/c shell check complains $? refers to condition not command and failed [ ... ] is always>
        result=1
        die "no status_file found, from which to discover timestamp" 1
    fi
}

normalize_timestamp() {
  # if YYYY-MM-DD HH:MM:SS, convert to YYYYMMDD-HH:MM:SS
  local _nt_candidate_ts="$1" _nt_reply=""
  case "$1" in
    # pattern 2: YYYY-MM-DD HH:MM:SS
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' '[0-9][0-9]:[0-9][0-9]:[0-9][0-9])
      _nt_reply="${_nt_candidate_ts:0:4}"   #..# year
      _nt_reply+="${_nt_candidate_ts:5:2}"    # month
      _nt_reply+="${_nt_candidate_ts:8:2}"    # day
      _nt_reply+="-"   #......................# delimiter
      _nt_reply+="${_nt_candidate_ts:11:8}"   # hh:mm:ss
      printf '%s\n' "$_nt_reply"
      ;;

    # pattern 1: YYYYMMDD-HH:MM:SS
    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9]:[0-9][0-9]:[0-9][0-9])
      # allow caller to assign this as global ts
      printf '%s\n' "$_nt_candidate_ts"
      ;;

    # does not match either layout shape (bit 0)
    *) die "Invalid timestamp [$_nt_candidate_ts]" 1 ;;
  esac
}

# shell check thinks using script's global status variables are unused
# shellcheck disable=SC2034
read_status()
{   local key="" value=""
    j_msg "-${debug}" -p "in ${FUNCNAME[0]}"
    # ensuer status_file exists
    [ -s "$status_file" ] || return 0
    # treat the status file as data - do not just source it
    while IFS='=' read -r key value; do
        value="${value#\"}"   # ltrim
        value="${value%\"}"   # rtrim
        #
        case "$key" in
            phase)                 phase="$value" ;;
            initial_pkglist_count) initial_pkglist_count="$value" ;;
            pkglist_count)         pkglist_count="$value" ;;
            prog_start)            prog_start="$value" ;;
            cur_pkg_name)          cur_pkg_name="$value" ;;
            cur_pkg_start)         cur_pkg_start="$value" ;;
            prog_end)              prog_end="$value" ;;
            *)                     die "invalid assignment in status_file" ;;
        esac
    done < "$status_file"
}

dump_status() {
    j_msg "-${debug}" -p "in ${FUNCNAME[0]}"
    for x in phase pkglist_count prog_start cur_pkg_name cur_pkg_start; do
        printf '%s\n' "${x}: ${!x}"
    done
}


# @ret emits validated latest timestamp on stdout
# @note since this is designed to run in a subshell, to return ts on stdout, no debug
# @append or other informational output is generated in this function

list_ts(){
    [ "$1" = "-h" ] &&
        { j_msg "-${notice}" -p "usage: list_ts [/path/to/target_dir]"; return 0 ; }
    local -a find_args=()
    local discovered_ts=""
    local result=0
    local target_dir="${1:-/tmp/}"
    local latest_status_file=""
    local template="${target_dir%/}/test-harness-status-"
    # identify the most recent status file
    # find files matching template; exclude files with .tmp|.tbz2 extension print path (%p)
    # build find_args in an array in order to comment/explain each
    find_args=( "${target_dir}" -mindepth 1 -maxdepth 1 )   # look inside the dir only, not at it or subdirs
    find_args+=( -type f -wholename "$template"'*' )    # filter for files with name matching template
    find_args+=( ! -name '*.tmp' )   #......................# exclude .tmp files to avoid accicental selection
    find_args+=( ! -name '*.tbz2' )   #.....................# exclude .tbz2 files to avoid accicental selection
    find_args+=( -printf '%p\n' )   #.......................# print path (date-sortable b/c ts in in filename)
    # pipe find output through filters - sort (latest last); strip template from prefix
    j_msg "-${notice}" -p "Found the following timestamps in target_dir [$target_dir]"
    if ! find "${find_args[@]}" | sort | sed "s|$template||"; then
        die "failed to find"
    fi
}

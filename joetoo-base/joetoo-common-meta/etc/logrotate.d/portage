# Portage logs
#/var/log/emerge.log /var/log/portage/* /var/log/portage/elog/* {
/var/log/emerge.log {
#  su root portage
    maxage 365
    size 1M
    notifempty
    missingok
    compress
    copytruncate
    sharedscripts
}


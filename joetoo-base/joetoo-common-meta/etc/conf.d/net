# Configure _pvc_VPN_INTERFACES below and uncomment call above if applicable
# (i.e. if using OpenVPN and a policy enforcement requirement is identified)
postup_vpn_client() {
    pvc_ret=0
    _pvc_VPN_INTERFACES="tun0"
    _pvc_FAIL_MSG="(warning) postup_vpn_client placeholder command failed on IFACE [${IFACE}]"
    logger -t conf_d-net -p local5.info "postup_vpn_client invoked for IFACE [${IFACE}]"

    if _run_for_interfaces "$_pvc_VPN_INTERFACES" "$_pvc_FAIL_MSG" \
        echo " * postup_vpn_client invoked for IFACE [${IFACE}], but this is not implemented yet" ; then
        pvc_ret=0; else pvc_ret=$?; fi

    unset -v _pvc_VPN_INTERFACES _pvc_FAIL_MSG
    return "$pvc_ret"
}

# helper function to run a command for a given interface if it matches vs interface list
# warn if command fails, and return exit status, but do not die here (let that be a policy decision)
_run_for_interfaces() {
    rfi_ret=0
    # argument validation
    if [ "$#" -lt 3 ]; then
        ewarn "_run_for_interfaces requires interface-list, failure-message, and command"
        logger -t conf_d-net -p local5.err "_run_for_interfaces invoked with insufficient arguments"
        return 2
    fi

    # assign _rfi_interface_list and _rfi_fail_msg from first two positional parameters
    _rfi_interface_list="$1"
    _rfi_fail_msg="$2"
    shift 2
    # the remaining positional parameters ($@) are the command to be executed

    # match IFACE vs space-separated list
    case " ${_rfi_interface_list} " in
        *" ${IFACE} "*)
            if "$@" ; then
                rfi_ret=0
            else
                rfi_ret=$?
                ewarn "$_rfi_fail_msg"
                logger -t conf_d-net -p local5.warning "$_rfi_fail_msg"
            fi
            ;;
    esac

    unset -v _rfi_interface_list _rfi_fail_msg
    return "$rfi_ret"
}
